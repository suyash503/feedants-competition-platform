NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/feedants

# Auth (JWT_SECRET is required in production)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
ENABLE_DEV_LOGIN=true

# Payments: "mock" follows Razorpay's order + HMAC signature flow
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=change-me-too

# Business rules
SEAT_HOLD_MINUTES=10
HOLD_SWEEP_INTERVAL_MS=30000
WRITE_RATE_LIMIT_PER_MINUTE=30
REFERRAL_BASE_URL=https://feedants.com/r/
CORS_ORIGIN=*
